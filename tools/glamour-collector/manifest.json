{
  "manifest_version": 3,
  "name": "Kawari Glamour Collector",
  "version": "1.2.1",
  "description": "Adds the Eorzea Collection glamour you're viewing to a list, and sends it to your ArchonEngine ControlPanel for the server's party bots.",
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Kawari glamour list",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ffxiv.eorzeacollection.com/glamour/*"],
      "js": ["format.js", "parse.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
