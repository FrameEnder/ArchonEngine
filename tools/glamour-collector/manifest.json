{
  "manifest_version": 3,
  "name": "Kawari Glamour Collector",
  "version": "1.0.0",
  "description": "Adds the Eorzea Collection glamour you're viewing to a list, for Kawari's party bots (glamours.txt).",
  "permissions": ["storage"],
  "action": {
    "default_title": "Kawari glamour list",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ffxiv.eorzeacollection.com/glamour/*"],
      "js": ["format.js", "parse.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
